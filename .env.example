# ---- Cloudflare R2 (S3-compatible) ----
R2_ACCESS_KEY_ID=your_key
R2_SECRET_ACCESS_KEY=your_secret
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET=socialpulse-data-lake

# ---- PostgreSQL warehouse ----
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=socialpulse
PG_USER=postgres
PG_PASSWORD=postgres

# ---- Synthetic data generation (optional overrides) ----
SEED=42
N_USERS=500
N_POSTS_PER_DAY=1500
N_ENGAGEMENTS_PER_DAY=10000
INJECT_DIRTY_DATA=true
DIRTY_RATE=0.03

# ---- Data-quality circuit breaker ----
# Fail the Silver stage if more than this share of a dataset is rejected.
MAX_REJECT_RATE=0.10

# ---- Local working directories ----
DATA_DIR=data
LOG_DIR=logs
